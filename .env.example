# =========================================================
# The Borderbound Official Platform — Environment Variables
# (Free-Tier Architecture)
# =========================================================

# Database: MongoDB Atlas M0 Free Tier (512MB limit)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/borderbound?retryWrites=true&w=majority

# NextAuth.js Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_a_random_32_character_secret_here

# Google OAuth Provider (Free - Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Admin JWT Authentication
ADMIN_EMAIL=admin@borderbound.show
ADMIN_PASSWORD_HASH=generate_a_secure_bcrypt_hash
ADMIN_JWT_SECRET=generate_a_dedicated_admin_jwt_secret

# Cloudinary Media Storage (Free Tier - 25GB Storage / Bandwidth)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google reCAPTCHA v3 (Free Tier - Bot Protection)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_v3_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_v3_secret_key

# Public App URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
